# Copy to .env and fill in. Everything here has a working default except
# SESSION_SECRET, which the app refuses to start without in production.

# Where the app is reached. Used for links in emails, so it must be the URL
# your housemate actually opens — not localhost.
APP_URL=http://truenas.local:3000

# Directory holding the SQLite file. In Docker this is the mounted volume.
DATA_DIR=/data

# Signs session cookies. Generate with:  openssl rand -base64 48
# Changing this logs everyone out.
SESSION_SECRET=

# Household timezone. Drives calendar-date maths for due dates and reminders.
TZ=Australia/Sydney

# --- Email (optional) ---------------------------------------------------
# Leave SMTP_HOST blank and the app runs normally, just without notifications.
# A blank line means "unset" for every variable here, not "empty string".
# Replies to MAIL_FROM go nowhere by design: it is a no-reply address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
